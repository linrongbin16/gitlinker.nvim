{
  "diagnostics.globals": [
    "vim",
    "describe",
    "before_each",
    "it",
    "jit",
    "utf8"
  ],
  "diagnostics.disable": [
    "luadoc-miss-symbol",
    "missing-return"
  ],
  "runtime.version": "LuaJIT",
  "workspace.checkThirdParty": "Disable",
  "workspace.ignoreDir": [
    "lua/gitlinker/async",
    "lua/gitlinker/async.lua",
    "gitlinker/async",
    "gitlinker/async.lua"
  ]
}
